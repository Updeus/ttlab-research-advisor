{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Updeus/ttlab-research-advisor/data/evaluation/retrieval_silver_v1.schema.json",
  "title": "TTLAB independently verified AI-reviewed silver retrieval judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "source_case_id",
    "question",
    "category",
    "answerability",
    "relevant_paper_ids",
    "supporting_evidence",
    "distractor_paper_ids",
    "rationale",
    "split",
    "label_quality",
    "timestamp",
    "annotation_uncertainty",
    "second_pass_note",
    "decision",
    "verification_rationale",
    "disagreement",
    "adjudication",
    "relevance_judgments",
    "creation_annotation",
    "verifier_id",
    "reviewer_type",
    "pass",
    "shuffled_position",
    "shuffle_seed"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^ret-silver-[0-9]{3}$"},
    "source_case_id": {"type": "string", "pattern": "^ret-create-[0-9]{3}$"},
    "question": {"type": "string", "minLength": 10},
    "category": {
      "enum": [
        "exact_factual_lookup",
        "methods",
        "results",
        "limitations_future_work",
        "title_author_venue",
        "topic_application",
        "comparison",
        "broad_intent",
        "multi_paper_synthesis",
        "hard_negative",
        "unanswerable_out_of_corpus"
      ]
    },
    "answerability": {"enum": ["answerable", "unanswerable"]},
    "relevant_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "chunk_id", "page_start", "page_end", "section", "source_hash", "evidence_summary"],
        "properties": {
          "paper_id": {"type": "string", "minLength": 1},
          "chunk_id": {"type": "string", "minLength": 1},
          "page_start": {"type": ["integer", "null"], "minimum": 1},
          "page_end": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": ["string", "null"]},
          "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_summary": {"type": "string", "minLength": 10}
        }
      }
    },
    "metadata_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "title", "authors", "year", "venue"],
        "properties": {
          "paper_id": {"type": "string"},
          "title": {"type": "string"},
          "authors": {"type": "array", "items": {"type": "string"}},
          "year": {"type": ["integer", "null"]},
          "venue": {"type": ["string", "null"]}
        }
      }
    },
    "distractor_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "corpus_absence_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "matching_chunk_count"],
      "properties": {
        "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "matching_chunk_count": {"type": "integer", "minimum": 0}
      }
    },
    "rationale": {"type": "string", "minLength": 10},
    "split": {"enum": ["dev", "test"]},
    "label_quality": {"const": "silver"},
    "timestamp": {"type": "string", "format": "date-time"},
    "annotation_uncertainty": {"enum": ["low", "medium", "high"]},
    "second_pass_note": {"type": "string", "minLength": 10},
    "decision": {"enum": ["agree", "revise"]},
    "verification_rationale": {"type": "string", "minLength": 20},
    "disagreement": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "creation_label", "verification_finding"],
          "properties": {
            "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "creation_label": {"type": "string"},
            "verification_finding": {"type": "string"}
          }
        }
      ]
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolution"],
      "properties": {
        "status": {"enum": ["not_needed", "resolved_by_ai_verifier"]},
        "resolution": {"type": "string", "minLength": 10}
      }
    },
    "relevance_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "grade", "label"],
        "properties": {
          "paper_id": {"type": "string"},
          "grade": {"enum": [0, 1, 2]},
          "label": {"enum": ["hard_negative", "partially_relevant", "directly_relevant"]}
        }
      }
    },
    "creation_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewer_type", "pass", "timestamp"],
      "properties": {
        "reviewer_id": {"const": "codex-ai-review"},
        "reviewer_type": {"const": "ai"},
        "pass": {"const": "create"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "verifier_id": {"const": "codex-ai-review"},
    "reviewer_type": {"const": "ai"},
    "pass": {"const": "verify"},
    "shuffled_position": {"type": "integer", "minimum": 1, "maximum": 50},
    "shuffle_seed": {"const": 20260712}
  }
}
