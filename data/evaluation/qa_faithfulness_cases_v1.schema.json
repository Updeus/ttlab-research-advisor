{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Updeus/ttlab-research-advisor/data/evaluation/qa_faithfulness_cases_v1.schema.json",
  "title": "TTLAB linked AI-reviewed silver QA case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qa_case_id",
    "retrieval_case_id",
    "question",
    "category",
    "answerability",
    "split",
    "answer_points",
    "supporting_sources",
    "relevant_paper_ids",
    "distractor_paper_ids",
    "corpus_absence_check",
    "label_source",
    "created_at"
  ],
  "properties": {
    "qa_case_id": {"type": "string", "pattern": "^qa-silver-[0-9]{3}$"},
    "retrieval_case_id": {"type": "string", "pattern": "^ret-silver-[0-9]{3}$"},
    "question": {"type": "string", "minLength": 10},
    "category": {
      "enum": [
        "exact_factual_lookup",
        "methods",
        "results",
        "limitations_future_work",
        "title_author_venue",
        "topic_application",
        "comparison",
        "broad_intent",
        "multi_paper_synthesis",
        "hard_negative",
        "unanswerable_out_of_corpus"
      ]
    },
    "answerability": {"enum": ["answerable", "unanswerable"]},
    "split": {"enum": ["dev", "test"]},
    "answer_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answer_point_id", "point_type", "text", "paper_ids", "source_chunk_ids"],
        "properties": {
          "answer_point_id": {"type": "string", "pattern": "^qa-silver-[0-9]{3}-point-[0-9]{2}$"},
          "point_type": {"enum": ["source_supported_content", "metadata_authorship", "metadata_venue"]},
          "text": {"type": "string", "minLength": 5},
          "paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "supporting_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "chunk_id",
          "page_start",
          "page_end",
          "section",
          "source_hash",
          "evidence_summary",
          "paper_title",
          "pdf_sha256",
          "extracted_json_sha256"
        ],
        "properties": {
          "paper_id": {"type": "string", "minLength": 1},
          "chunk_id": {"type": "string", "minLength": 1},
          "page_start": {"type": ["integer", "null"], "minimum": 1},
          "page_end": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": ["string", "null"]},
          "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_summary": {"type": "string", "minLength": 10},
          "paper_title": {"type": "string", "minLength": 1},
          "pdf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "extracted_json_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "relevant_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "distractor_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "corpus_absence_check": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["terms", "matching_chunk_count"],
          "properties": {
            "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "matching_chunk_count": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "label_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "dataset_sha256",
        "source_case_id",
        "label_quality",
        "reviewer_type",
        "creation_pass",
        "verification_pass"
      ],
      "properties": {
        "dataset": {"const": "data/evaluation/retrieval_silver_v1.jsonl"},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_case_id": {"type": "string", "pattern": "^ret-silver-[0-9]{3}$"},
        "label_quality": {"const": "ai_reviewed_silver"},
        "reviewer_type": {"const": "ai"},
        "creation_pass": {"type": "object"},
        "verification_pass": {"type": "object"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"answerability": {"const": "answerable"}}},
      "then": {
        "properties": {
          "answer_points": {"minItems": 1},
          "supporting_sources": {"minItems": 1},
          "relevant_paper_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"answerability": {"const": "unanswerable"}}},
      "then": {
        "properties": {
          "answer_points": {"maxItems": 0},
          "supporting_sources": {"maxItems": 0},
          "relevant_paper_ids": {"maxItems": 0},
          "corpus_absence_check": {"type": "object"}
        }
      }
    }
  ]
}
