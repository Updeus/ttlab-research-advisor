{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttlab.local/schemas/section-quality-silver-v1.json",
  "title": "TTLAB section-quality silver case",
  "type": "object",
  "required": ["case_id", "paper_id", "chunk_id", "chunk_index", "page_start", "page_end", "source_hash", "predicted_section", "expected_section", "sampling_stratum", "source_heading_evidence", "rationale", "reviewer_id", "reviewer_type", "label_quality", "pass", "timestamp", "extracted_json_path"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "source_case_id": {"type": "string"},
    "paper_id": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "chunk_index": {"type": "integer", "minimum": 0},
    "page_start": {"type": "integer", "minimum": 1},
    "page_end": {"type": "integer", "minimum": 1},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predicted_section": {"$ref": "#/$defs/section"},
    "expected_section": {"$ref": "#/$defs/section"},
    "creation_expected_section": {"$ref": "#/$defs/section"},
    "sampling_stratum": {"enum": ["front_matter", "section_boundary", "section_interior"]},
    "source_heading_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["page_number", "heading_text", "location"], "properties": {"page_number": {"type": "integer", "minimum": 1}, "heading_text": {"type": "string", "minLength": 1}, "location": {"enum": ["within_chunk_pages", "adjacent_source_page"]}}, "additionalProperties": false}},
    "rationale": {"type": "string", "minLength": 20},
    "reviewer_id": {"const": "codex-ai-review"},
    "verifier_id": {"const": "codex-ai-review"},
    "reviewer_type": {"const": "ai"},
    "label_quality": {"const": "silver"},
    "pass": {"enum": ["create", "verify"]},
    "decision": {"enum": ["agree", "revise"]},
    "verification_rationale": {"type": "string"},
    "shuffle_seed": {"type": "integer"},
    "shuffled_position": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "extracted_json_path": {"type": "string", "minLength": 1}
  },
  "$defs": {"section": {"enum": ["Abstract", "Introduction", "Literature Review", "Methodology", "Results", "Discussion", "Conclusion", "References", "Unknown"]}},
  "additionalProperties": false
}
